# Local Autonomous AI Agent Environment Configuration
# Copy this file to .env and adjust values for your local system.

# Ollama Local LLM Configuration
# Default Ollama daemon host URL
OLLAMA_HOST=http://127.0.0.1:11434

# Specific model name (leave blank for automatic hardware-based selection)
# Examples: llama3.2:3b, qwen2.5-coder:1.5b, qwen2.5-coder:7b
OLLAMA_MODEL=

# Agent Sandboxed Workspace Path
AGENT_WORKSPACE=./agent_workspace

# Optional: External Integration Tokens (Leave blank until ready to enable)
# GitHub CLI / Personal Access Token for remote repository sync
GITHUB_TOKEN=

# Vercel Deployment Token
VERCEL_TOKEN=

# PayPal Sandbox Credentials (Testing only - never use production keys)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

